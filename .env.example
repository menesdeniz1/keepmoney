# Bu dosyayı `.env` olarak kopyala. `.env` git'e girmez.
# Tüm ayarlar KEEPMONEY_ öneklidir — tanımlar: keepmoney/ayarlar.py

KEEPMONEY_ORTAM=gelistirme          # gelistirme | test | uretim

# ── JWT imza anahtarı ────────────────────────────────────────────
# Üretimde ZORUNLU. En az 256 bit (32 bayt) — RFC 7518 §3.2.
# BOŞ BIRAKMA ve ELLE YAZMA: anahtar bir parola değil, CSPRNG çıktısıdır.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Üretimde bu değer GitHub Secrets / sunucu ortam değişkeninde durur,
# asla repoda değil.
KEEPMONEY_JWT_GIZLI_ANAHTAR=

# ── Veritabanı ───────────────────────────────────────────────────
# SQLite (varsayılan) ya da postgresql+psycopg://kullanici:parola@host/veritabani
KEEPMONEY_VERITABANI_URL=sqlite:///./data/keepmoney.sqlite

# ── Web ──────────────────────────────────────────────────────────
# Virgülle ayrılmış liste ya da JSON dizisi. Üretimde '*' KULLANILAMAZ:
# kimlik bilgisi taşıyan isteklerde tarayıcı reddeder (CORS spesifikasyonu).
KEEPMONEY_CORS_KAYNAKLARI=http://localhost:5173

# ── Telegram (Faz 4) ─────────────────────────────────────────────
KEEPMONEY_TELEGRAM_BOT_TOKEN=

# ── Alan adı (ters vekil / TLS) ──────────────────────────────────
# `docker compose` ile gelen Caddy sertifikayı BU ada göre alır ve yeniler.
# Yerel denemede `localhost` yaz — Caddy kendi imzaladığı sertifikayı
# kullanır (tarayıcı uyarır, akış çalışır).
KEEPMONEY_ALAN_ADI=

# ── Ters vekil ───────────────────────────────────────────────────
# HANGİ KAYNAKTAN GELEN `X-Forwarded-For` başlığına GÜVENİLİR.
# Boş (varsayılan) = HİÇBİRİNE; istemcinin bağlandığı adres kullanılır.
#
# NEDEN ÖNEMLİ (ölçüldü): başlık koşulsuz kullanıldığında her istekte farklı
# bir XFF yazarak giriş hız sınırı TAMAMEN atlatılabiliyordu — 40 başarısız
# denemenin 40'ı da geçti, tek bir 429 çıkmadı.
#
# Ters vekil (nginx/Caddy/Cloudflare) arkasındaysan vekilin ağını YAZ:
# yazmazsan tüm istekler vekilin IP'sinden geliyormuş gibi görünür ve IP
# başına sayan limitler (kayıt) herkes için tek kovaya düşer.
KEEPMONEY_GUVENILEN_VEKILLER=

# ── Ölçüm ucu (/metrics) ─────────────────────────────────────────
# Tanımlıysa `Authorization: Bearer <token>` zorunlu olur.
# ÜRETİMDE BOŞ BIRAKILIRSA UÇ KAPANIR (404) — kimliksiz açık bırakmaktansa.
# Geliştirmede boş = açık.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KEEPMONEY_METRIK_TOKENI=

# ── Kota ─────────────────────────────────────────────────────────
KEEPMONEY_KULLANICI_BASINA_IZLEME_LIMITI=30

# ── Gözlemlenebilirlik ───────────────────────────────────────────
# Tarayıcı süreci ölçümlerini KENDİ ucundan yayınlar; API'nin /metrics'i
# onları göremez (ayrı süreç = ayrı prometheus kayıt defteri).
# Prometheus iki hedefi de toplamalı: api:8000/metrics ve tarayici:9100
# 0 = kapalı.
KEEPMONEY_TARAYICI_METRIK_PORTU=9100

# ── E-posta (parola sıfırlama + adres doğrulama) ─────────────────
# SMTP_SUNUCU boşsa e-posta GÖNDERİLMEZ, bağlantı loga yazılır — SMTP
# kurmadan geliştirmek için. Üretimde boş bırakmak, "parolamı unuttum"
# akışının sessizce çalışmaması demektir (açılışta uyarılır).
KEEPMONEY_SMTP_SUNUCU=
KEEPMONEY_SMTP_PORT=587             # 465 → doğrudan SSL, diğerleri STARTTLS
KEEPMONEY_SMTP_KULLANICI=
KEEPMONEY_SMTP_PAROLA=
KEEPMONEY_EPOSTA_GONDEREN=KeepMoney <noreply@keepmoney.com>

# Kullanıcıya gönderilen bağlantıların tabanı — arayüzün genel adresi.
KEEPMONEY_SITE_ADRESI=http://localhost:5173

# ── Tarama ───────────────────────────────────────────────────────
# Playwright'ın kendi indirdiği tarayıcı yerine sistem chromium'u.
# Boşsa Playwright kendi sürümünü arar.
KEEPMONEY_PLAYWRIGHT_CALISTIRILABILIR=

# ── Ağ: API hangi adresi dinlesin ────────────────────────────────
# Boş/tanımsız = 127.0.0.1 → YALNIZCA bu bilgisayar.
# Ev ağındaki telefondan bakmak için: 0.0.0.0
#
# DİKKAT: 0.0.0.0 "aynı ağdaki herkes erişebilir" demektir. Ev ağında
# kabul edilebilir; ortak Wi-Fi'da (kafe, otel, yurt) KULLANMA. Doğrudan
# internete açma — hız sınırı ters vekil arkasında olmayı varsayıyor
# (bkz. docs/MIMARI.md K24).
KEEPMONEY_DINLEME=

# Günlük yedeğin nereye yazılacağı (macOS launchd işi okur).
# Boşsa <kök>/yedekler. Başka bir diske ya da iCloud/Drive klasörüne
# vermek daha doğru: aynı diskteki yedek, disk arızasında yedek değildir.
KEEPMONEY_YEDEK_DIZIN=

# ── Arayüz sunumu ────────────────────────────────────────────────
# Derlenmiş arayüzün dizini. Boşsa <kök>/statik kullanılır; dizin yoksa
# arayüz mount EDİLMEZ (yerel geliştirmede Vite kendi sunucusunu çalıştırır).
# Docker imajında bu dizini Dockerfile oluşturur.
KEEPMONEY_ARAYUZ_DIZINI=

# ── Hız sınırları ────────────────────────────────────────────────
# Doğru değer dağıtıma göre değişir: ofis NAT'ı arkasındaki tek IP ile
# halka açık bir kayıt sayfası aynı limiti kaldırmaz.
KEEPMONEY_GIRIS_LIMITI=8
KEEPMONEY_GIRIS_PENCERESI_SN=300
KEEPMONEY_KAYIT_LIMITI=5
KEEPMONEY_KAYIT_PENCERESI_SN=3600
KEEPMONEY_SIFIRLAMA_LIMITI=5
KEEPMONEY_SIFIRLAMA_PENCERESI_SN=3600

# Telegram botunun @kullanıcı adı (baştaki @ olmadan). Deep-link buna göre
# kurulur; yanlışsa bağlama akışı sessizce çalışmaz.
KEEPMONEY_TELEGRAM_BOT_ADI=KeepMoneyBot

# ── Oturum ve token ömürleri ─────────────────────────────────────
KEEPMONEY_JWT_OMUR_DK=10080          # 7 gün
KEEPMONEY_JWT_ALGORITMA=HS256        # yalnızca HS256/HS384/HS512
KEEPMONEY_OTURUM_CEREZI=km_oturum
KEEPMONEY_PAROLA_SIFIRLAMA_OMRU_DK=30
KEEPMONEY_EPOSTA_DOGRULAMA_OMRU_SAAT=48
KEEPMONEY_TELEGRAM_BAGLAMA_OMRU_DK=10
