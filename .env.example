# Bu dosyayı `.env` olarak kopyala. `.env` git'e girmez.
# Tüm ayarlar KEEPMONEY_ öneklidir — tanımlar: keepmoney/ayarlar.py

KEEPMONEY_ORTAM=gelistirme          # gelistirme | test | uretim

# ── JWT imza anahtarı ────────────────────────────────────────────
# Üretimde ZORUNLU. En az 256 bit (32 bayt) — RFC 7518 §3.2.
# BOŞ BIRAKMA ve ELLE YAZMA: anahtar bir parola değil, CSPRNG çıktısıdır.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Üretimde bu değer GitHub Secrets / sunucu ortam değişkeninde durur,
# asla repoda değil.
KEEPMONEY_JWT_GIZLI_ANAHTAR=

# ── Veritabanı ───────────────────────────────────────────────────
# SQLite (varsayılan) ya da postgresql+psycopg://kullanici:parola@host/veritabani
KEEPMONEY_VERITABANI_URL=sqlite:///./data/keepmoney.sqlite

# ── Web ──────────────────────────────────────────────────────────
# Virgülle ayrılmış liste ya da JSON dizisi. Üretimde '*' KULLANILAMAZ:
# kimlik bilgisi taşıyan isteklerde tarayıcı reddeder (CORS spesifikasyonu).
KEEPMONEY_CORS_KAYNAKLARI=http://localhost:5173

# ── Telegram (Faz 4) ─────────────────────────────────────────────
KEEPMONEY_TELEGRAM_BOT_TOKEN=

# ── Kota ─────────────────────────────────────────────────────────
KEEPMONEY_KULLANICI_BASINA_IZLEME_LIMITI=30

# ── Gözlemlenebilirlik ───────────────────────────────────────────
# Tarayıcı süreci ölçümlerini KENDİ ucundan yayınlar; API'nin /metrics'i
# onları göremez (ayrı süreç = ayrı prometheus kayıt defteri).
# Prometheus iki hedefi de toplamalı: api:8000/metrics ve tarayici:9100
# 0 = kapalı.
KEEPMONEY_TARAYICI_METRIK_PORTU=9100

# ── E-posta (parola sıfırlama + adres doğrulama) ─────────────────
# SMTP_SUNUCU boşsa e-posta GÖNDERİLMEZ, bağlantı loga yazılır — SMTP
# kurmadan geliştirmek için. Üretimde boş bırakmak, "parolamı unuttum"
# akışının sessizce çalışmaması demektir (açılışta uyarılır).
KEEPMONEY_SMTP_SUNUCU=
KEEPMONEY_SMTP_PORT=587             # 465 → doğrudan SSL, diğerleri STARTTLS
KEEPMONEY_SMTP_KULLANICI=
KEEPMONEY_SMTP_PAROLA=
KEEPMONEY_EPOSTA_GONDEREN=KeepMoney <noreply@keepmoney.com>

# Kullanıcıya gönderilen bağlantıların tabanı — arayüzün genel adresi.
KEEPMONEY_SITE_ADRESI=http://localhost:5173

# ── Tarama ───────────────────────────────────────────────────────
# Playwright'ın kendi indirdiği tarayıcı yerine sistem chromium'u.
# Boşsa Playwright kendi sürümünü arar.
KEEPMONEY_PLAYWRIGHT_CALISTIRILABILIR=
